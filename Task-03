#include <stdio.h>

/* Device positions */

enum
{
    LIGHT = 0,
    FAN = 1,
    AC = 2,
    HEATER = 3,
    PUMP = 4
};


/* Switch ON */

unsigned char switch_on(unsigned char reg, int dev)
{
    reg = reg | (1u << dev);

    return reg;
}


/* Switch OFF */

unsigned char switch_off(unsigned char reg, int dev)
{
    reg = reg & ~(1u << dev);

    return reg;
}


/* Toggle device */

unsigned char toggle(unsigned char reg, int dev)
{
    reg = reg ^ (1u << dev);

    return reg;
}


/* Check device status */

int is_on(unsigned char reg, int dev)
{
    return (reg >> dev) & 1u;
}


/* Display binary register */

void show(unsigned char reg)
{
    int bit;

    for (bit = 7; bit >= 0; bit--)
    {
        putchar(((reg >> bit) & 1u) ? '1' : '0');
    }

    putchar('\n');
}


int main(void)
{
    unsigned char reg = 0;

    /* Switch ON LIGHT */

    reg = switch_on(reg, LIGHT);

    /* Switch ON AC */

    reg = switch_on(reg, AC);

    show(reg);

    /* Toggle FAN */

    reg = toggle(reg, FAN);

    /* Switch OFF LIGHT */

    reg = switch_off(reg, LIGHT);

    show(reg);

    printf("AC is %s, PUMP is %s\n",
           is_on(reg, AC) ? "ON" : "OFF",
           is_on(reg, PUMP) ? "ON" : "OFF");

    return 0;
}
